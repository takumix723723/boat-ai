PORT=3001

# ローカル開発用。本番（Render）は backend/.env.production.example を参照
# 手順: docs/RENDER_DEPLOY.md

# auto = 実データ取得、失敗時モック / live = 実データのみ / mock = モックのみ
BOATRACE_DATA_MODE=auto

# PostgreSQL（Neon / Render Postgres 等）
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Phase6: Live更新後にスナップショットをDB保存（要 DATABASE_URL）
PERSIST_SNAPSHOTS=false

# Boatrace Open API ベース（通常変更不要）
# BOATRACE_OPENAPI_BASE=https://boatraceopenapi.github.io

# 実データキャッシュ TTL（ミリ秒）
# BOATRACE_CACHE_TTL_MS=300000

# Live HTTP 取得（retry / timeout）
# BOATRACE_FETCH_TIMEOUT_MS=25000
# BOATRACE_FETCH_RETRIES=2
# BOATRACE_FETCH_RETRY_DELAY_MS=800

# Prisma ログ
# PRISMA_LOG=true

# Phase16: 自動学習（既定 suggest = 候補のみ保存）
# AI_LEARNING_MODE=manual|suggest|auto
# AI_LEARNING_MODE=suggest
# AI_LEARNING_ENABLED=true
# AI_LEARNING_SCHEDULER_ENABLED=true
# AI_LEARNING_AFTER_REFRESH=true
# AI_LEARNING_MIN_IMPROVEMENT=1
# AI_LEARNING_MIN_RACES=4
# AI_LEARNING_TRIALS=48
# AI_LEARNING_COOLDOWN_HOURS=12
# AI_LEARNING_DAILY_HOUR_UTC=19
