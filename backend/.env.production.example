# Render Web Service（boat-ai-api）に設定する環境変数の例
# Dashboard → boat-ai-api → Environment

# Render が自動設定（通常は触らない）
# PORT=10000
# NODE_ENV=production
# RENDER=true

# --- 必須（本番AIとして常時稼働） ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.neon.tech/neondb?sslmode=require
PERSIST_SNAPSHOTS=true
BOATRACE_DATA_MODE=auto

# --- 起動（Render）---
# migrate deploy は非ブロック（P1002 advisory lock で起動停止しない）
# MIGRATE_DEPLOY_TIMEOUT_MS=20000
# MIGRATE_ON_STARTUP=false

# --- 推奨 ---
# 実データ取得のタイムアウト（無料プランは cold start で遅くなりがち）
# BOATRACE_FETCH_TIMEOUT_MS=30000
# BOATRACE_FETCH_RETRIES=2

# --- 任意 ---
# BOATRACE_OPENAPI_BASE=https://boatraceopenapi.github.io
# BOATRACE_CACHE_TTL_MS=300000
# PRISMA_LOG=true
# フロントの URL（CORS を絞る場合・将来用）
# CORS_ORIGIN=https://boat-ai-web.onrender.com

# Phase16: 自動学習（Render 常駐でスケジューラ稼働）
# AI_LEARNING_MODE=suggest
# AI_LEARNING_SCHEDULER_ENABLED=true
# AI_LEARNING_AFTER_REFRESH=true
